#!/usr/bin/env bash
# The only command the GitHub runner's user may run as root (/etc/sudoers.d/kasra-gate). Every call must
# send DEPLOY_TOKEN on the first line of stdin. Only jobs approved in the protected "production" GitHub
# environment receive that secret, so a workflow that was not approved cannot change the server even
# though it runs on it. Installed as /usr/local/sbin/kasra-gate by install-runner.sh.
#
#   printf '%s\n' "$DEPLOY_TOKEN" | sudo -n /usr/local/sbin/kasra-gate <task> [arguments]
#
# Tasks that run repository code (inspect, provision, enable-domain, deploy) take the job's checkout
# directory and copy deploy/ into a root-only directory first, so the runner cannot change it mid-run.
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BIN=/opt/kasra/bin
fail() { echo "kasra-gate: $*" >&2; exit 2; }

[ "$(id -u)" = 0 ] || fail "run through sudo"
expected=$(cat /etc/kasra/gate.sha256 2>/dev/null) || fail "not installed (run install-runner.sh)"
IFS= read -r token || true
if [ "$(printf '%s' "${token:-}" | sha256sum | cut -d' ' -f1)" != "$expected" ]; then
  sleep 3
  fail "refused: missing or wrong DEPLOY_TOKEN (only approved production jobs have it)"
fi
unset token

task=${1:-}
[ $# -gt 0 ] && shift

# Copies <checkout>/deploy to a fresh root-owned directory and prints its path.
stage() {
  local src=$1 dir
  [ -f "$src/deploy/server/lib.sh" ] || fail "$src does not contain the deploy/ scripts"
  dir=$(mktemp -d /root/kasra-stage.XXXXXX)
  tar -C "$src" -cf - deploy | tar -C "$dir" -xf - --no-same-owner
  echo "$dir"
}
cleanup() { [ -n "${staged:-}" ] && rm -rf "$staged"; return 0; }
trap cleanup EXIT

# A newer gate shipped with the repository replaces this one atomically (bash keeps reading the old file).
refresh_gate() {
  local new=$staged/deploy/server/kasra-gate
  if [ -f "$new" ] && ! cmp -s "$new" /usr/local/sbin/kasra-gate; then
    install -m 0755 "$new" /usr/local/sbin/kasra-gate.new && mv /usr/local/sbin/kasra-gate.new /usr/local/sbin/kasra-gate
    echo "kasra-gate updated"
  fi
}

case "$task" in
  inspect)
    staged=$(stage "${1:?checkout directory}")
    bash "$staged/deploy/server/inspect.sh" ;;
  provision)
    src=${1:?checkout}; site_url=${2:?site url}; demo=${3:?demo data true/false}; harden=${4:?harden true/false}
    [[ $site_url =~ ^https://[a-z0-9.-]+$ ]] || fail "site url must look like https://host"
    [[ $demo =~ ^(true|false)$ && $harden =~ ^(true|false)$ ]] || fail "demo data and harden are true or false"
    host=${site_url#https://}
    server_ip=""
    [[ $host =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && server_ip=$host
    staged=$(stage "$src")
    SERVER_IP=$server_ip SITE_URL=$site_url SEED_DEMO_DATA=$demo HARDEN=$harden bash "$staged/deploy/server/provision.sh"
    refresh_gate ;;
  enable-domain)
    src=${1:?checkout}; domain=${2:?domain}; email=${3:-}; www=${4:-false}; skip=${5:-false}
    [[ $www =~ ^(true|false)$ && $skip =~ ^(true|false)$ ]] || fail "www and skip-dns-check are true or false"
    staged=$(stage "$src")
    DOMAIN=$domain EMAIL=$email WWW=$www SKIP_DNS_CHECK=$skip bash "$staged/deploy/server/enable-domain.sh" ;;
  infra-missing)
    # Prints the database/cache images the release needs that are not on the server yet.
    command -v docker >/dev/null 2>&1 || fail "the server is not provisioned yet (Production operations > provision)"
    staged=$(stage "${1:?checkout}")
    KASRA_RELEASE=x POSTGRES_PASSWORD=x ORDER_TOKEN_SECRET=x REDIS_PASSWORD=x NEXT_PUBLIC_SITE_URL=x \
      docker compose -f "$staged/deploy/compose.production.yaml" config --images | grep -v '^kasra-' |
      while read -r image; do docker image inspect "$image" >/dev/null 2>&1 || echo "$image"; done ;;
  deploy)
    release=${1:?commit}; src=${2:?checkout}
    [[ $release =~ ^[0-9a-f]{40}$ ]] || fail "release must be a 40-character commit"
    bundle=$src/bundle/kasra-images-$release.tar.gz
    [ -f "$bundle" ] || fail "release bundle $bundle is missing"
    [ -d /opt/kasra ] || fail "the server is not provisioned yet (Production operations > provision)"
    staged=$(stage "$src")
    install -d -m 0700 /opt/kasra/incoming
    install -m 0600 "$bundle" "/opt/kasra/incoming/kasra-images-$release.tar.gz"
    if [ -f "$src/infra/infra-images.tar.gz" ]; then
      install -m 0600 "$src/infra/infra-images.tar.gz" /opt/kasra/incoming/infra-images.tar.gz
    fi
    rm -f "$bundle"
    bash "$staged/deploy/server/deploy.sh" "$release"
    refresh_gate ;;
  status)
    "$BIN/status.sh" "${1:-2h}" ;;
  backup)
    "$BIN/backup.sh" manual ;;
  rollback)
    "$BIN/rollback.sh" ${1:+"$1"} ;;
  restore)
    "$BIN/restore.sh" "${1:?backup file}" ${2:+"$2"} ;;
  create-owner)
    # The rest of stdin (after the token line) is the owner's password.
    "$BIN/create-owner.sh" "${1:?username}" ;;
  *)
    fail "unknown task '$task' (inspect provision enable-domain infra-missing deploy status backup rollback restore create-owner)" ;;
esac
