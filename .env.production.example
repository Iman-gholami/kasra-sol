NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.example
POSTGRES_USER=kasra
POSTGRES_DB=kasra
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
ORDER_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_API_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SEED_DEMO_DATA=false
# Where Docker builds download npm packages. If `docker compose up --build` stalls at `npm install` (common from
# Iran), set a mirror that answers from your network, e.g. NPM_REGISTRY=https://registry.npmmirror.com/
NPM_REGISTRY=https://registry.npmjs.org/
