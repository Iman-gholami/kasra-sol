NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_USER=kasra
POSTGRES_DB=kasra
# Choose URL-safe random secrets, e.g. `openssl rand -hex 32` for each one. The API refuses to start
# with these placeholders (and treats the ADMIN_API_KEY example as unset); replace them even locally.
POSTGRES_PASSWORD=change-me-to-strong-url-safe-password
ORDER_TOKEN_SECRET=replace-this-with-a-random-64-char-secret-before-deployment
ADMIN_API_KEY=replace-this-with-a-random-64-char-admin-token
SEED_DEMO_DATA=true
# Where Docker builds download npm packages. If `docker compose up --build` stalls at `npm install` (common from
# Iran), set a mirror that answers from your network, e.g. NPM_REGISTRY=https://registry.npmmirror.com/
NPM_REGISTRY=https://registry.npmjs.org/
